#!/usr/bin/env bash
# Preflight, then bring up the headless compose stack (modules + Hath web).
set -euo pipefail

cd "$(dirname "$0")"

HOSTS_LINE="127.0.0.1  dwar.dadi yaad.dadi dimaag.dadi nas.dadi hath.dadi"

ensure_env() {
  local module="$1"
  local env_path="../${module}/.env"
  local example_path="../${module}/.env.example"
  if [ ! -f "$env_path" ]; then
    if [ ! -f "$example_path" ]; then
      echo "up: missing ${env_path} and no .env.example to copy from" >&2
      exit 1
    fi
    cp "$example_path" "$env_path"
    echo "up: created ${env_path} from .env.example"
  fi
}

ensure_env dwar
ensure_env yaad
ensure_env dimaag

if ! grep -q '\.dadi' /etc/hosts; then
  echo "up: /etc/hosts is missing .dadi entries. Add this line and re-run:" >&2
  echo "  ${HOSTS_LINE}" >&2
  exit 1
fi

if ! grep -q 'hath\.dadi' /etc/hosts; then
  echo "up: /etc/hosts is missing hath.dadi. Add or update to:" >&2
  echo "  ${HOSTS_LINE}" >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "up: docker is not running" >&2
  exit 1
fi

if [ ! -d ../hath ]; then
  echo "up: ../hath does not exist" >&2
  exit 1
fi

mkdir -p .run
# Dev Nas state dir (module env/config editable via Nas APIs). Seed once before compose reads env_file.
if [ ! -d .run/dadi/modules ]; then
  mkdir -p .run/dadi/modules/dwar .run/dadi/modules/yaad .run/dadi/modules/dimaag .run/dadi/cloudflared
  for mod in dwar yaad dimaag; do
    if [ -f "../${mod}/.env" ]; then
      cp "../${mod}/.env" ".run/dadi/modules/${mod}/.env"
    else
      cp "../${mod}/.env.example" ".run/dadi/modules/${mod}/.env"
    fi
  done
  cp ../dwar/config.toml .run/dadi/modules/dwar/config.toml
  : > .run/dadi/cloudflared/token
fi

# Fresh session: reset Loki so Alloy does not serve stale history.
docker compose stop loki alloy >/dev/null 2>&1 || true
docker compose rm -f loki >/dev/null 2>&1 || true
docker volume rm dadi_loki_data >/dev/null 2>&1 || true

exec docker compose up --build "$@"
