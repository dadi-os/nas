# Control service. Required; compose and the appliance units set these.
HEADSCALE_USER=dadi
LISTEN_ADDR=:8080
LOKI_URL=http://loki:3100
# Dwar (the browser and terminal helpers' model calls), Chaavi (their secrets) and the cgroup
# whose memory limits how many browsers run.
DWAR_URL=http://dwar:8080
CHAAVI_URL=http://chaavi:8080
BROWSER_CGROUP=/sys/fs/cgroup
DADI_STATE_DIR=/var/lib/dadi
DADI_HOME=/home/dadi
DADI_RUNTIME=compose
# Required when DADI_RUNTIME=compose.
DADI_COMPOSE_DIR=/nas

# Optional. Browser binary for agent browsers; unset uses chromium-browser.
# CHROMIUM_BIN=chromium
