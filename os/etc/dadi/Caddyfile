	import mesh_only
	reverse_proxy 127.0.0.1:8082
}

http://dimaag.dadi {
	import mesh_only
	reverse_proxy 127.0.0.1:8083
}

http://ghar.dadi {
	import mesh_only
	reverse_proxy 127.0.0.1:8084
}

# Hath / Dimaag keep cleartext /v1 + /health. Vault UI redirects to HTTPS
# (Bitwarden Subtle Crypto / clients require a secure context).
http://chaavi.dadi {
	import mesh_only
	handle /v1* {
		reverse_proxy 127.0.0.1:8085
	}
	handle /health {
		reverse_proxy 127.0.0.1:8085
	}
	handle {
		redir https://chaavi.dadi{uri} permanent
	}
}

https://chaavi.dadi {
	import mesh_only
	tls /var/lib/dadi/caddy/tls/chaavi.crt /var/lib/dadi/caddy/tls/chaavi.key
	handle /v1* {
		reverse_proxy 127.0.0.1:8085
	}
	handle /health {
		reverse_proxy 127.0.0.1:8085
	}
	handle {
		reverse_proxy 127.0.0.1:8086
	}
}

http://nas.dadi {
	import mesh_only
	reverse_proxy 127.0.0.1:8092
}

