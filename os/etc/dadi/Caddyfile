{
	admin off
	auto_https off
}

(mesh_only) {
	@wan not remote_ip 127.0.0.1/32 ::1/128 10.88.0.0/16 10.89.0.0/16 100.64.0.0/10 fd7a:115c:a1e0::/48
	abort @wan
}

http://dwar.dadi {
	import mesh_only
	reverse_proxy 127.0.0.1:8081
}

