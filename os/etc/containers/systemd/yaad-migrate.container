[Unit]
After=dadi-seed.service yaad-postgres.service
Requires=dadi-seed.service yaad-postgres.service

[Container]
Image=ghcr.io/dadi-os/yaad:latest
ContainerName=yaad-migrate
Network=dadi.network
Environment=DATABASE_URL=postgres://yaad:yaad@yaad-postgres:5432/yaad
Exec=node dist/db/migrate.js
AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
