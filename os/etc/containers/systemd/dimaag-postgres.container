[Unit]
After=dadi-seed.service
Requires=dadi-seed.service

[Container]
Image=docker.io/library/postgres:18

ContainerName=dimaag-postgres
Network=dadi.network
Environment=POSTGRES_USER=dimaag
Environment=POSTGRES_DB=dimaag
Environment=POSTGRES_PASSWORD=dimaag
Volume=dimaag_pg.volume:/var/lib/postgresql
HealthCmd=pg_isready -U dimaag -d dimaag
HealthInterval=2s
HealthTimeout=5s
HealthRetries=20
Notify=healthy
# PostgreSQL 18 crash-recovers when an untracked child dies. pg_isready runs in
# this PID namespace and gets reparented to PID 1; init reaps it instead.
RunInit=true

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
