[Unit]
After=dadi-seed.service
Requires=dadi-seed.service

[Container]
Image=docker.io/pgvector/pgvector:pg18

ContainerName=yaad-postgres
Network=dadi.network
Environment=POSTGRES_USER=yaad
Environment=POSTGRES_DB=yaad
Environment=POSTGRES_PASSWORD=yaad
Volume=yaad_pg.volume:/var/lib/postgresql
HealthCmd=pg_isready -U yaad -d yaad
HealthInterval=2s
HealthTimeout=5s
HealthRetries=20
Notify=healthy
# PostgreSQL 18 crash-recovers when an untracked child dies. pg_isready runs in
# this PID namespace and gets reparented to PID 1; init reaps it instead.
RunInit=true

[Service]
Restart=always
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
