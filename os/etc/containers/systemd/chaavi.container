[Unit]
After=dadi-seed.service
Requires=dadi-seed.service

[Container]
Image=ghcr.io/dadi-os/chaavi:latest
ContainerName=chaavi
Network=dadi.network
PublishPort=127.0.0.1:8085:8080
Environment=DOMAIN=https://chaavi.dadi
Environment=SIGNUPS_ALLOWED=true
Environment=ROCKET_PORT=8080
Environment=EXPERIMENTAL_CLIENT_FEATURE_FLAGS=pm-32009-new-item-types
EnvironmentFile=/var/lib/dadi/modules/chaavi/.env
Volume=chaavi_vault.volume:/data
AutoUpdate=registry
HealthCmd=wget -qO- http://127.0.0.1:8080/health
HealthInterval=10s
HealthTimeout=5s
HealthRetries=4
HealthStartPeriod=60s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
