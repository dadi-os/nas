[Unit]
After=dadi-seed.service hath-postgres.service hath-migrate.service
Requires=dadi-seed.service
BindsTo=hath-postgres.service
Wants=hath-migrate.service

[Container]
Image=ghcr.io/dadi-os/hath:latest
ContainerName=hath
Network=dadi.network
PublishPort=127.0.0.1:8083:8080
AddHost=dwar.dadi:host-gateway
AddHost=yaad.dadi:host-gateway
AddHost=hath.dadi:host-gateway
AddHost=ghar.dadi:host-gateway
AddHost=chaavi.dadi:host-gateway
AddHost=nas.dadi:host-gateway
Environment=DATABASE_URL=postgres://hath:hath@hath-postgres:5432/hath
EnvironmentFile=/var/lib/dadi/timezone.env
AutoUpdate=registry
HealthCmd=node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=2s
HealthTimeout=5s
HealthRetries=30

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
WantedBy=hath-postgres.service
