[Unit]
After=dadi-seed.service dimaag-postgres.service dimaag-migrate.service
Requires=dadi-seed.service dimaag-postgres.service
Wants=dimaag-migrate.service

[Container]
Image=ghcr.io/dadi-os/dimaag:latest
ContainerName=dimaag
Network=dadi.network
PublishPort=127.0.0.1:8083:8080
AddHost=dwar.dadi:host-gateway
AddHost=yaad.dadi:host-gateway
AddHost=dimaag.dadi:host-gateway
AddHost=nas.dadi:host-gateway
EnvironmentFile=/var/lib/dadi/modules/dimaag/.env
AutoUpdate=registry
HealthCmd=node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthInterval=2s
HealthTimeout=5s
HealthRetries=30

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
