[Unit]
After=dadi-seed.service dimaag-postgres.service
Requires=dadi-seed.service dimaag-postgres.service

[Container]
Image=ghcr.io/dadi-os/dimaag:latest
ContainerName=dimaag-migrate
Network=dadi.network
Environment=DATABASE_URL=postgres://dimaag:dimaag@dimaag-postgres:5432/dimaag
Exec=node dist/db/migrate.js
AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
