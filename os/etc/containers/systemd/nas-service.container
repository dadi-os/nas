[Unit]
After=dadi-seed.service bootstrap.service loki.service
Requires=dadi-seed.service bootstrap.service
Wants=loki.service

[Container]
Image=ghcr.io/dadi-os/nas-service:latest
ContainerName=nas-service
Network=dadi.network
Environment=CONTROL_URL=https://headscale.dadi.ardusa.dev
Environment=HEADSCALE_USER=ankur
Environment=LISTEN_ADDR=:8080
Environment=LOKI_URL=http://loki:3100
Environment=DADI_STATE_DIR=/var/lib/dadi
Environment=DADI_RUNTIME=podman
Volume=/var/lib/dadi:/var/lib/dadi
Volume=/etc/headscale/config.yaml:/etc/headscale/config.yaml:ro
Volume=headscale_data.volume:/var/lib/headscale
Volume=headscale_run.volume:/var/run/headscale
AutoUpdate=registry
HealthCmd=curl -sf http://127.0.0.1:8080/health
HealthInterval=2s
HealthTimeout=5s
HealthRetries=30
PublishPort=8092:8080
PodmanArgs=--privileged --pid=host

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
