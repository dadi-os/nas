[Unit]
Description=Hath kiosk under cage
After=network-online.target seatd.service caddy.service nas-service.service dadi-seed.service
Wants=network-online.target seatd.service caddy.service

[Service]
Type=simple
User=ankur
Group=ankur
SupplementaryGroups=video render input
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HATH_LOG_FILE=/var/lib/dadi/hath/hath.log
Environment=WLR_LIBINPUT_NO_DEVICES=1
WorkingDirectory=/var/lib/dadi/hath
ExecStartPre=+/usr/bin/mkdir -p /run/user/1000
ExecStartPre=+/usr/bin/chown ankur:ankur /run/user/1000
ExecStartPre=+/usr/libexec/dadi/ensure-hath.sh
ExecStartPre=+/usr/bin/chown -R ankur:ankur /var/lib/dadi/hath
ExecStart=/usr/bin/cage -s -- /var/lib/dadi/hath/hath.AppImage --no-sandbox
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
