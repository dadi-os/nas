[Unit]
Description=Block idle, sleep, and lid-triggered sleep
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep:handle-lid-switch --who=dadiOS --why="appliance display stays up" --mode=block /usr/bin/sleep infinity
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
