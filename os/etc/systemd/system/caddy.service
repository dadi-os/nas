[Unit]
Description=Caddy reverse proxy for *.dadi
After=dadi-seed.service dwar.service yaad.service dimaag.service ghar.service chaavi-vault.service chaavi.service nas.service
Wants=dadi-seed.service dwar.service yaad.service dimaag.service ghar.service chaavi-vault.service chaavi.service nas.service

[Service]
Type=simple
Environment=XDG_DATA_HOME=/var/lib
ExecStartPre=/usr/bin/mkdir -p /var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/dadi/Caddyfile --adapter caddyfile
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
