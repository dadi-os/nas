[Unit]
Description=WireGuard link from the box to the public relay
After=network-online.target dadi-seed.service
Wants=network-online.target
ConditionPathExists=/etc/wireguard/dadi-relay.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/wg-quick up dadi-relay
ExecStop=/usr/bin/wg-quick down dadi-relay

[Install]
WantedBy=multi-user.target
