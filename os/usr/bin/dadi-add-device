#!/usr/bin/env bash
# Launch Add Device (mesh provisioning QR).
set -euo pipefail
export QML_IMPORT_PATH="/var/lib/dadi/qml-import:/usr/share/dadi/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export QML2_IMPORT_PATH="/var/lib/dadi/qml-import:/usr/share/dadi/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
if command -v plasmawindowed >/dev/null 2>&1; then
  exec plasmawindowed org.dadi.adddevice
fi
exec /usr/bin/qml6 /usr/share/dadi/add-device/main.qml "$@"
