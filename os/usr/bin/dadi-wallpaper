#!/bin/bash
# Apply a dadi field wallpaper by id: Bloom | Mist | Vein
set -euo pipefail
name="${1:-Bloom}"
case "$name" in
  Bloom|Mist|Vein) ;;
  *) echo "usage: dadi-wallpaper Bloom|Mist|Vein" >&2; exit 1 ;;
esac
path="/usr/share/wallpapers/Dadi${name}/contents/images/1920x1080.png"
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
  plasma-apply-wallpaperimage "$path"
else
  echo "plasma-apply-wallpaperimage missing; wallpaper at $path" >&2
  exit 1
fi
