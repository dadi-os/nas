# Build from repo root: podman build -f os/Containerfile .
FROM golang:1.23-bookworm AS nas-build
WORKDIR /src
COPY service/go.mod ./
COPY service/*.go ./
RUN CGO_ENABLED=0 go build -o /nas .

FROM headscale/headscale:0.26 AS headscale
FROM caddy:2.9.1-alpine AS caddy
FROM grafana/loki:3.4.2 AS loki
FROM grafana/alloy:v1.7.1 AS alloy

FROM quay.io/fedora/fedora-bootc:42

RUN dnf -y install \
    podman \
    openssh-server \
    curl \
    jq \
    vim-minimal \
    git \
    mesa-dri-drivers \
    mesa-vulkan-drivers \
    libglvnd-egl \
    fuse \
    fuse-libs \
    plasma-desktop \
    plasma-workspace \
    plasma-workspace-wayland \
    plasma-nm \
    plasma-pa \
    sddm \
    sddm-breeze \
    dolphin \
    konsole \
    kscreen \
    qt6-qtdeclarative \
    plymouth \
    plymouth-plugin-script \
    google-noto-sans-fonts \
    google-noto-sans-gujarati-fonts \
    google-noto-sans-mono-fonts \
    librsvg2-tools \
    qrencode \
    ImageMagick \
    wl-clipboard \
    nftables \
    tpm2-tools \
    fido2-tools \
  && dnf clean all

# Tailscale client (open-source); Headscale is the control plane.
RUN curl -fsSL https://pkgs.tailscale.com/stable/fedora/tailscale.repo \
      -o /etc/yum.repos.d/tailscale.repo \
  && dnf -y install tailscale \
  && dnf clean all

# Cloudflare tunnel binary (not in Fedora repos).
RUN curl -fsSL -o /usr/local/bin/cloudflared \
      https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 \
  && chmod 0755 /usr/local/bin/cloudflared

COPY --from=nas-build /nas /usr/local/bin/nas
COPY --from=headscale /ko-app/headscale /usr/local/bin/headscale
COPY --from=caddy /usr/bin/caddy /usr/local/bin/caddy
COPY --from=loki /usr/bin/loki /usr/local/bin/loki
COPY --from=alloy /bin/alloy /usr/local/bin/alloy

# video/render/input live in /usr/lib/group (nss-altfiles); shadow-utils only reads /etc/group.
RUN grep -E '^(video|render|input):' /usr/lib/group >> /etc/group

# /home is machine state — create the account without writing a home directory.
RUN useradd \
    --uid 1000 \
    --groups wheel,video,render,input \
    --home-dir /home/ankur \
    --no-create-home \
    --shell /bin/bash \
    ankur

RUN mkdir -p /usr/ssh /var/lib/headscale /var/lib/loki /var/lib/alloy

COPY os/etc/ /etc/
COPY os/usr/ /usr/
COPY os/authorized_keys /usr/ssh/ankur-authorized-keys

# Render Plymouth / SDDM / icon brand marks from SVG (Gujarati દાદી).
RUN mkdir -p \
      /usr/share/plymouth/themes/dadi \
      /usr/share/sddm/themes/dadi \
      /usr/share/pixmaps \
      /usr/share/icons/hicolor/48x48/apps \
      /usr/share/icons/hicolor/128x128/apps \
  && rsvg-convert -w 640 -h 240 /usr/share/dadi/brand/dadi-wordmark.svg \
       -o /usr/share/plymouth/themes/dadi/wordmark.png \
  && rsvg-convert -w 480 -h 180 /usr/share/dadi/brand/dadi-wordmark.svg \
       -o /usr/share/sddm/themes/dadi/wordmark.png \
  && cp -a /usr/share/wallpapers/Dadi/contents/images/1920x1080.png \
       /usr/share/sddm/themes/dadi/background.png \
  && rsvg-convert -w 64 -h 64 /usr/share/dadi/brand/dadi-mark.svg \
       -o /usr/share/pixmaps/dadi.png \
  && rsvg-convert -w 48 -h 48 /usr/share/dadi/brand/dadi-mark.svg \
       -o /usr/share/icons/hicolor/48x48/apps/dadi.png \
  && rsvg-convert -w 128 -h 128 /usr/share/dadi/brand/dadi-mark.svg \
       -o /usr/share/icons/hicolor/128x128/apps/dadi.png \
  && mkdir -p /usr/lib64/qt6/qml/org/dadi \
  && ln -sfn /usr/share/dadi/qml/org/dadi/Desktop /usr/lib64/qt6/qml/org/dadi/Desktop \
  && chmod 0755 /usr/bin/dadi-preferences \
       /usr/bin/dadi-add-device /usr/bin/dadi-provision-qr \
  && plymouth-set-default-theme dadi \
  && for k in /lib/modules/*; do \
       [ -d "$k" ] || continue; \
       dracut --force --kver "$(basename "$k")" || true; \
     done

RUN chmod 0440 /etc/sudoers.d/ankur \
  && chmod 0644 /usr/ssh/ankur-authorized-keys \
  && chmod 0755 /usr/libexec/dadi/*.sh \
  && chmod 0755 /usr/share/dadi/bootstrap.sh \
  && systemctl enable sshd.service \
  && systemctl enable dadi-seed.service \
  && systemctl enable dadi-home.service \
  && systemctl enable sddm.service \
  && systemctl enable cloudflared.service \
  && systemctl enable headscale.service \
  && systemctl enable bootstrap.service \
  && systemctl enable tailscaled.service \
  && systemctl enable dadi-tailscale.service \
  && systemctl enable loki.service \
  && systemctl enable alloy.service \
  && systemctl enable nas.service \
  && systemctl enable caddy.service \
  && systemctl enable nftables.service \
  && systemctl enable podman-auto-update.timer

# Last occurrence wins in os-release parsers — brand as dadiOS without
# changing ID (bootc-image-builder keys off ID=fedora for distro defs).
RUN printf '%s\n' \
  'NAME="dadiOS"' \
  'PRETTY_NAME="dadiOS"' \
  'VARIANT="dadiOS"' \
  'VARIANT_ID=dadios' \
  >> /usr/lib/os-release

RUN bootc container lint
