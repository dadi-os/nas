# Build from repo root: podman build -f os/Containerfile .
FROM golang:1.23-bookworm AS nas-build
WORKDIR /src
COPY service/go.mod service/go.sum ./
COPY service/*.go ./
COPY service/helpers ./helpers
RUN CGO_ENABLED=0 go build -o /nas .

FROM headscale/headscale:0.26 AS headscale
FROM caddy:2.9.1-alpine AS caddy
FROM grafana/loki:3.4.2 AS loki
FROM grafana/alloy:v1.7.1 AS alloy

FROM quay.io/fedora/fedora-bootc:44

RUN dnf -y install \
    podman \
    wireguard-tools \
    openssh-server \
    samba \
    policycoreutils-python-utils \
    bash-completion \
    curl \
    jq \
    vim-minimal \
    git \
    tmux \
    ripgrep \
    util-linux \
    procps-ng \
    xorg-x11-server-Xvfb \
    chromium \
    dejavu-sans-fonts \
    liberation-fonts \
    google-noto-emoji-fonts \
    mesa-dri-drivers \
    mesa-vulkan-drivers \
    libglvnd-egl \
    fuse \
    fuse-libs \
    plymouth \
    plymouth-plugin-script \
    google-noto-sans-fonts \
    google-noto-sans-gujarati-fonts \
    google-noto-sans-mono-fonts \
    librsvg2-tools \
    qrencode \
    ImageMagick \
    ffmpeg-free \
    nftables \
    openssl \
    miniupnpc \
    tpm2-tools \
    tpm2-tss \
    cryptsetup \
    fido2-tools \
  && dnf clean all

# ffmpeg-free pulls in noopenh264, a stub whose encoder never opens; Cisco's openh264 replaces it, and encoding one frame fails the build if the stub is back.
RUN dnf -y install --allowerasing openh264 \
  && dnf clean all \
  && ffmpeg -nostdin -loglevel error -f lavfi -i testsrc=size=320x240:rate=5 -frames:v 5 -c:v libopenh264 -f null -

# Tailscale client (open-source); Headscale is the control plane.
RUN curl -fsSL https://pkgs.tailscale.com/stable/fedora/tailscale.repo \
      -o /etc/yum.repos.d/tailscale.repo \
  && dnf -y install tailscale \
  && dnf clean all

COPY --from=nas-build /nas /usr/bin/nas
COPY --from=headscale /ko-app/headscale /usr/bin/headscale
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY --from=loki /usr/bin/loki /usr/bin/loki
COPY --from=alloy /bin/alloy /usr/bin/alloy

# video/render/input live in /usr/lib/group (nss-altfiles); shadow-utils only reads /etc/group.
RUN grep -E '^(video|render|input):' /usr/lib/group >> /etc/group

RUN mkdir -p /var/lib/headscale /var/lib/loki /var/lib/alloy

# smbd serves the dadi home ([dadi] in smb.conf), which keeps its var_lib_t / container_file_t labels.
RUN semanage boolean --modify --on samba_export_all_rw

COPY os/etc/ /etc/
COPY os/usr/ /usr/

RUN systemd-sysusers \
  && usermod -aG video,render,input dadi \
  && passwd -d dadi

# Render the Plymouth boot splash wordmark from SVG (Gujarati દાદી).
RUN mkdir -p /usr/share/plymouth/themes/dadi \
  && rsvg-convert -w 640 -h 240 /usr/share/dadi/brand/dadi-wordmark.svg \
       -o /usr/share/plymouth/themes/dadi/wordmark.png \
  && chmod 0755 /usr/bin/dadi \
  && plymouth-set-default-theme dadi \
  && for k in /lib/modules/*; do \
       [ -d "$k" ] || continue; \
       dracut --force --kver "$(basename "$k")" || true; \
     done

RUN chmod 0440 /etc/sudoers.d/dadi-wheel \
  && chmod 0755 /usr/libexec/dadi/*.sh \
  && chmod 0755 /usr/share/dadi/bootstrap.sh \
  && systemctl enable sshd.service \
  && systemctl enable smb.service \
  && systemctl enable dadi-seed.service \
  && systemctl enable dadi-home.service \
  && systemctl enable dadi-tpm-enroll.service \
  && systemctl enable dadi-inhibit-idle.service \
  && systemctl set-default multi-user.target \
  && systemctl mask tuned.service \
  && systemctl mask clevis-luks-askpass.service \
  && systemctl mask clevis-luks-askpass.path \
  && systemctl enable dadi-publish.timer \
  && systemctl enable dadi-relay.service \
  && systemctl enable headscale.service \
  && systemctl enable bootstrap.service \
  && systemctl enable tailscaled.service \
  && systemctl enable dadi-tailscale.service \
  && systemctl enable loki.service \
  && systemctl enable alloy.service \
  && systemctl enable nas.service \
  && systemctl enable caddy.service \
  && systemctl enable nftables.service \
  && systemctl enable podman-auto-update.timer \
  && ln -sfn /usr/share/zoneinfo/America/New_York /etc/localtime

# Last occurrence wins in os-release parsers — brand as dadiOS without
# changing ID (bootc-image-builder keys off ID=fedora for distro defs).
RUN printf '%s\n' \
  'NAME="dadiOS"' \
  'PRETTY_NAME="dadiOS"' \
  'VARIANT="dadiOS"' \
  'VARIANT_ID=dadios' \
  >> /usr/lib/os-release

RUN bootc container lint
