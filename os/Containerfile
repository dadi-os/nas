FROM quay.io/fedora/fedora-bootc:42

RUN dnf -y install \
    podman \
    openssh-server \
    curl \
    jq \
    vim-minimal \
    git \
  && dnf clean all

# /home is machine state — create the account without writing a home directory.
RUN useradd \
    --uid 1000 \
    --groups wheel \
    --home-dir /home/ankur \
    --no-create-home \
    --shell /bin/bash \
    ankur

RUN mkdir -p /usr/ssh

COPY etc/ /etc/
COPY authorized_keys /usr/ssh/ankur-authorized-keys

RUN chmod 0440 /etc/sudoers.d/ankur \
  && chmod 0644 /usr/ssh/ankur-authorized-keys \
  && systemctl enable sshd.service

# Last occurrence wins in os-release parsers — brand as dadiOS without
# changing ID (bootc-image-builder keys off ID=fedora for distro defs).
RUN printf '%s\n' \
  'NAME="dadiOS"' \
  'PRETTY_NAME="dadiOS"' \
  'VARIANT="dadiOS"' \
  'VARIANT_ID=dadios' \
  >> /usr/lib/os-release

RUN bootc container lint
