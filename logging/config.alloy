discovery.docker "dadi" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "dadi" {
  targets = discovery.docker.dadi.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["service"]
    regex         = "nas-service"
    target_label  = "service"
    replacement   = "nas"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "dadi" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.dadi.output
  relabel_rules = discovery.relabel.dadi.rules
  forward_to    = [loki.process.normalize.receiver]
}

local.file_match "hath" {
  path_targets = [{
    __path__ = "/var/log/hath/hath.log",
    service  = "hath",
  }]
}

loki.source.file "hath" {
  targets    = local.file_match.hath.targets
  forward_to = [loki.process.normalize.receiver]
}

loki.process "normalize" {
  forward_to = [loki.write.local.receiver]

  // Log store + collector themselves, plus infra that is not in the Hath
  // explorer (postgres, mesh control plane, oneshots).
  stage.drop {
    source     = "service"
    expression = "^(alloy|loki|.*-postgres|headscale|tailscale|bootstrap)$"
  }

  // App modules emit JSON lines (time/level/service/msg). Drop npm/tsx banners,
  // Node deprecation dumps, and postgres-js NOTICE objects that arrive as
  // pretty-printed multi-line fragments.
  stage.match {
    selector = `{service=~"dimaag|yaad|dwar|nas|hath"}`

    stage.json {
      expressions = {
        level = "level",
        msg   = "msg",
      }
      drop_malformed = true
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
