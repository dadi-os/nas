discovery.docker "dadi" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "dadi" {
  targets = discovery.docker.dadi.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["service"]
    regex         = "nas-service"
    target_label  = "service"
    replacement   = "nas"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "dadi" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.dadi.output
  relabel_rules = discovery.relabel.dadi.rules
  forward_to    = [loki.process.normalize.receiver]
}

loki.process "normalize" {
  forward_to = [loki.write.local.receiver]

  stage.drop {
    source     = "service"
    expression = "^(alloy|loki|caddy|hath|.*-postgres|.*-migrate|headscale|tailscale|bootstrap)$"
  }

  stage.match {
    selector = `{service=~"dimaag|yaad|dwar|nas"}`

    stage.json {
      expressions = {
        level      = "level",
        msg        = "msg",
        code       = "code",
        request_id = "request_id",
      }
      drop_malformed = true
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
