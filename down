#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

wipe=false
if [ "${1:-}" = "--wipe" ]; then
  wipe=true
elif [ $# -gt 0 ]; then
  echo "usage: $0 [--wipe]" >&2
  exit 1
fi

if [ "$wipe" = true ]; then
  echo "down: wiping Docker volumes"
  docker compose down -v
else
  docker compose down
fi
